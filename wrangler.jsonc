{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-inbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "observability": { "enabled": true },
  "vars": { "INBOX_DOMAIN": "agent-inbox.d-mato.dev" },
  "routes": [{ "pattern": "agent-inbox.d-mato.dev", "custom_domain": true }],
  "workers_dev": false,
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-inbox",
      "database_id": "15d0bdfc-0d6f-48f9-8900-9769c11da829"
    }
  ]
}
